# SITE_ADDRESS is ":80" by default (plain HTTP behind the access layer); set a domain in
# .env to get automatic HTTPS. Authentication is handled by the external access layer.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# /api/* -> FastAPI, with the /api prefix stripped (same as the Vite dev proxy).
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Everything else: static web app, with SPA fallback to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
