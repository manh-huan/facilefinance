# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=facilefinance
POSTGRES_PASSWORD=change-me
# Host port for local development (127.0.0.1 only). Change it if 5432 is taken.
DB_PORT=5432

# --- Application ---
# Local development (api and worker in Docker get this from docker-compose.yml).
# Use 127.0.0.1, not localhost: localhost can hang with Docker on Windows.
DATABASE_URL=postgresql+psycopg://facilefinance:change-me@127.0.0.1:5432/facilefinance

# Database for tests. The name must end in _test: its public schema is dropped and recreated.
FACILEFINANCE_TEST_DATABASE_URL=postgresql+psycopg://facilefinance:change-me@127.0.0.1:5432/facilefinance_test

# Host port for nginx.
HTTP_PORT=80

# --- AI (only src/facilefinance/ai/ reads this) ---
ANTHROPIC_API_KEY=

# --- Email (transactional SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
